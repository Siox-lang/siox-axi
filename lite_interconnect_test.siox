module lite_interconnect_test;

use std::bits::unsigned;
use axi::lite::{AxiLite, Subordinate, Interconnect, OKAY, DECERR};

// A one-register subordinate: a write is accepted when address and data are
// both offered, a read returns the register one cycle after its address.
entity Register { clk: Bit in, bus: AxiLite<32, 32> Subordinate }
impl Register {
    let value: unsigned[32] = 0;
    let bvalid: Bit = '0';
    let rvalid: Bit = '0';
    let rdata: unsigned[32] = 0;
    let take_write: Bit;
    let take_read: Bit;
    take_write = bus.awvalid and bus.wvalid and not bvalid;
    take_read = bus.arvalid and not rvalid;
    step: process {
        if clk.rising() {
            if take_write {
                value = bus.wdata;
                bvalid = '1';
            } else if bus.bready {
                bvalid = '0';
            }
            if take_read {
                rdata = value;
                rvalid = '1';
            } else if bus.rready {
                rvalid = '0';
            }
        }
    }
    bus.awready = take_write;
    bus.wready = take_write;
    bus.bvalid = bvalid;
    bus.bresp = OKAY;
    bus.arready = take_read;
    bus.rvalid = rvalid;
    bus.rdata = rdata;
    bus.rresp = OKAY;
}

// Two registers behind the interconnect, 4 KiB apart.
entity System { clk: Bit in, up: AxiLite<32, 32> Subordinate }
impl System {
    let down: AxiLite<32, 32>[2];
    let bus: Interconnect<32, 32, 2, 12> = { .clk = clk, .up = up, .down = down };
    let r0: Register = { .clk = clk, .bus = down[0] };
    let r1: Register = { .clk = clk, .bus = down[1] };
}

#[test]
entity LiteInterconnectTest {}
impl LiteInterconnectTest {
    let clk: Bit = '0';
    let bus: AxiLite<32, 32>;
    let dut: System = { .clk = clk, .up = bus };
    bus.awprot = 0; bus.arprot = 0; bus.wstrb = 0xF;
    bus.awvalid = '0'; bus.wvalid = '0'; bus.arvalid = '0';
    bus.bready = '1'; bus.rready = '1';

    // Write 0xA0 + k to register k, and once past the map.
    for k in 0..2 {
        bus.awaddr = k * 0x1000; bus.wdata = 0xA0 + k;
        bus.awvalid = '1'; bus.wvalid = '1';
        for cycle in 0..5 {
            await 1ns;
            let aw_taken: Bit = bus.awvalid and bus.awready;
            let w_taken: Bit = bus.wvalid and bus.wready;
            if bus.bvalid == '1' {
                assert!((k < 2 and bus.bresp == OKAY) or (k == 2 and bus.bresp == DECERR),
                        "write response from the addressed subordinate");
            }
            clk = '1'; await 1ns; clk = '0';
            if aw_taken == '1' { bus.awvalid = '0'; }
            if w_taken == '1' { bus.wvalid = '0'; }
        }
        assert!(bus.awvalid == '0' and bus.wvalid == '0', "both write channels were taken");
    }
    // Read them back.
    for k in 0..2 {
        bus.araddr = k * 0x1000; bus.arvalid = '1';
        let seen: Bit = '0';
        for cycle in 0..5 {
            await 1ns;
            let ar_taken: Bit = bus.arvalid and bus.arready;
            if bus.rvalid == '1' {
                seen = '1';
                if k < 2 {
                    assert!(bus.rdata == 0xA0 + k and bus.rresp == OKAY, "each register holds its own word");
                } else {
                    assert!(bus.rresp == DECERR, "an unmapped read errors");
                }
            }
            clk = '1'; await 1ns; clk = '0';
            if ar_taken == '1' { bus.arvalid = '0'; }
        }
        assert!(seen == '1', "every read got a response");
    }
}
